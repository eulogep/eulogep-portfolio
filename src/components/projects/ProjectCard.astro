---
import { getEvidenceAsset, getEvidenceFor, isImageItem } from '../../data/visual-evidence';
import { authorshipLabels, isProjectDetailEligible, type PublicProject } from '../../lib/page-models';

interface Props {
  project: PublicProject;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const hasDetail = isProjectDetailEligible(project);

// Only a real capture of the running project may appear here; projects without
// one get no image at all rather than a placeholder that could pass for proof.
const capture = compact ? undefined : getEvidenceFor(project.project_id, 'interface').find(isImageItem);
const thumbnail = capture && (() => {
  const asset = getEvidenceAsset(capture.assetId);
  const base = `/evidence/${asset.project}/${asset.name}`;
  return {
    avif: asset.widths.map((width) => `${base}-${width}.avif ${width}w`).join(', '),
    fallback: `${base}-${asset.width}.webp`,
    width: asset.width,
    height: asset.height,
  };
})();
---

<article class:list={['project-card', { 'project-card--compact': compact, 'project-card--media': thumbnail }]} data-project-id={project.project_id}>
  {thumbnail && (
    <div class="project-card__media">
      <picture>
        <source type="image/avif" srcset={thumbnail.avif} sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw" />
        {/* The full capture, with its caption and alt text, is on the case study. Here it only previews it. */}
        <img src={thumbnail.fallback} width={thumbnail.width} height={thumbnail.height} alt="" loading="lazy" decoding="async" />
      </picture>
      <span class="project-card__media-label">Capture réelle</span>
    </div>
  )}
  <p class="project-card__index" aria-hidden="true">Projet</p>
  <div class="project-card__meta">
    <span>{project.status}</span>
    <span>{authorshipLabels[project.authorship] ?? project.authorship}</span>
  </div>
  <h3>{hasDetail ? <a href={`/projects/${project.slug}/`}>{project.title}</a> : project.title}</h3>
  {project.summary && <p>{project.summary}</p>}
  {!project.summary && project.capabilities.length > 0 && <p>{project.capabilities.slice(0, 2).join(' · ')}</p>}
  {!project.summary && project.capabilities.length === 0 && (
    <p class="muted">Présentation détaillée différée : preuves publiques encore insuffisantes.</p>
  )}
  {project.technologies.length > 0 && (
    <ul class="tag-list" aria-label={`Technologies de ${project.title}`}>
      {project.technologies.slice(0, compact ? 4 : 6).map((technology) => <li>{technology}</li>)}
    </ul>
  )}
  <div class="card-actions">
    {hasDetail && <a class="text-link" href={`/projects/${project.slug}/`}>Voir le projet</a>}
    {project.repository_url && (
      <a class="text-link" href={project.repository_url} rel="noreferrer">Dépôt public</a>
    )}
  </div>
</article>
