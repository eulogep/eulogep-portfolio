---
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import SectionHeading from '../../components/content/SectionHeading.astro';
import CorrectorAIDiagram from '../../components/architecture/diagrams/CorrectorAIDiagram.astro';
import EngineerLearningOSDiagram from '../../components/architecture/diagrams/EngineerLearningOSDiagram.astro';
import ProfessionalHubDiagram from '../../components/architecture/diagrams/ProfessionalHubDiagram.astro';
import EvidenceStack from '../../components/evidence/EvidenceStack.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import { getEvidenceFor } from '../../data/visual-evidence';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  authorshipLabels,
  getProjectDetailProjects,
  getRelatedProjects,
  type PublicProject,
} from '../../lib/page-models';
import { getPublicPortfolio } from '../../lib/public-data';

export function getStaticPaths() {
  return getProjectDetailProjects().map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: PublicProject;
}

const { project } = Astro.props;
const portfolio = getPublicPortfolio();
const relatedProjects = getRelatedProjects(project);
const testCapabilities = project.capabilities.filter((capability) => /test|ci\b/i.test(capability));
const implementationCapabilities = project.capabilities.filter((capability) => !/test|ci\b/i.test(capability));
const description = project.summary ?? `${project.title} : profil technique public et limites documentées.`;
// Only projects with evidence-grounded architecture have a diagram; the others omit the section.
const architectureDiagrams = {
  'project-elos': EngineerLearningOSDiagram,
  'project-professional-hub': ProfessionalHubDiagram,
  'project-corrector-ai': CorrectorAIDiagram,
} as const;
const ArchitectureDiagram = architectureDiagrams[project.project_id as keyof typeof architectureDiagrams];
const interfaceEvidence = getEvidenceFor(project.project_id, 'interface');
const executionEvidence = getEvidenceFor(project.project_id, 'execution');
const projectLogo = project.project_id === 'project-manga-wave' ? '/gallery/manga-wave-mark.svg' : undefined;
const mangaWavePresentation = project.project_id === 'project-manga-wave'
  ? {
      src: 'https://manga-wave-bienvenue-fusion.vercel.app/media/manga-wave-presentation-16x9.mp4',
      poster: '/media/manga-wave-presentation-poster.webp',
    }
  : undefined;
---

<BaseLayout
  title={`${project.title} — Étude de projet | Euloge Mabiala`}
  description={description}
  displayName={portfolio.profile.display_name}
  identityVersion={portfolio.identity_version}
  githubUrl={portfolio.contact.url}
  currentPath={`/projects/${project.slug}/`}
  openGraphType="article"
>
  <article class="project-detail">
    <header class="page-header container project-header">
      <Breadcrumbs items={[{ label: 'Accueil', href: '/' }, { label: 'Projets', href: '/projects/' }, { label: project.title }]} />
      <div class="project-header__identity">
        {projectLogo && <img class="project-header__logo" src={projectLogo} width="512" height="512" alt="" />}
        <div>
          <p class="eyebrow">{project.classification} · {project.status}</p>
          <h1>{project.title}</h1>
        </div>
      </div>
      {project.summary && <p class="lead">{project.summary}</p>}
      <dl class="project-metadata">
        <div><dt>Attribution</dt><dd>{authorshipLabels[project.authorship] ?? project.authorship}</dd></div>
        {project.maturity && <div><dt>Maturité observée</dt><dd>{project.maturity}</dd></div>}
        {project.last_verified && <div><dt>Dernière vérification</dt><dd>{project.last_verified}</dd></div>}
      </dl>
      <div class="action-row">
        {project.repository_url && <a class="button" href={project.repository_url} rel="noreferrer">Consulter le dépôt public</a>}
        <a class="button button--secondary" href="/projects/">Retour aux projets</a>
      </div>
    </header>

    <section class="project-section container reading-width" aria-labelledby="role-title">
      <h2 id="role-title">Rôle et attribution</h2>
      <p>Niveau d’attribution public : <strong>{authorshipLabels[project.authorship] ?? project.authorship}</strong>.</p>
      {project.authorship === 'PARTIAL' && <p>La présentation porte uniquement sur la contribution documentée ; elle ne revendique pas l’ensemble du projet.</p>}
    </section>

    {ArchitectureDiagram && (
      <section class="project-section container" aria-labelledby="architecture-title">
        <h2 id="architecture-title">Architecture</h2>
        <p class="architecture-intro">
          Ce que le système reçoit, comment les données circulent, ce qui est conservé et ce qui est validé, tel qu’observé dans le code public.
        </p>
        <ArchitectureDiagram repositoryUrl={project.repository_url} />
      </section>
    )}

    {implementationCapabilities.length > 0 && (
      <section class="project-section container reading-width" aria-labelledby="implementation-title">
        <h2 id="implementation-title">Implémentation documentée</h2>
        <ul class="evidence-list">
          {implementationCapabilities.map((capability) => <li>{capability}</li>)}
        </ul>
      </section>
    )}

    {mangaWavePresentation && (
      <section class="project-section container" aria-labelledby="project-presentation-title">
        <div class="project-presentation__heading reading-width">
          <p class="eyebrow">Présentation produit · 40 secondes</p>
          <h2 id="project-presentation-title">Manga Wave en mouvement</h2>
          <p class="architecture-intro">
            Une présentation visuelle de l’expérience, du catalogue à la reprise de lecture.
          </p>
        </div>
        <figure class="project-presentation">
          <video
            controls
            playsinline
            preload="metadata"
            poster={mangaWavePresentation.poster}
            aria-label="Présentation vidéo de l’expérience Manga Wave"
          >
            <source src={mangaWavePresentation.src} type="video/mp4" />
            Votre navigateur ne peut pas lire cette vidéo.
          </video>
          <figcaption>
            <p>
              Démonstration visuelle du produit. Elle illustre l’interface et les parcours, sans constituer une preuve technique indépendante.
              Les couvertures et contenus affichés appartiennent à leurs ayants droit.
            </p>
            <a class="text-link" href={mangaWavePresentation.src} target="_blank" rel="noreferrer">
              Ouvrir la vidéo dans un nouvel onglet
            </a>
          </figcaption>
        </figure>
      </section>
    )}

    {interfaceEvidence.length > 0 && (
      <section class="project-section container" aria-labelledby="interface-evidence-title">
        <h2 id="interface-evidence-title">Interface observée</h2>
        <p class="architecture-intro">Captures du projet en fonctionnement, avec leur source et leurs limites.</p>
        <EvidenceStack items={interfaceEvidence} />
      </section>
    )}

    {project.project_id === 'project-manga-wave' && (
      <section class="project-section container reading-width boundary-note" aria-labelledby="attribution-boundary-title">
        <h2 id="attribution-boundary-title">Implémentation personnelle et composants tiers</h2>
        <p><strong>Implémentation présentée :</strong> l’architecture applicative et les mécanismes listés dans les capacités documentées ci-dessus.</p>
        <p><strong>Éléments tiers :</strong> les contenus, sources externes et dépôts amont ne sont pas revendiqués comme appartenant à Euloge Mabiala.</p>
      </section>
    )}

    {project.technologies.length > 0 && (
      <section class="project-section container reading-width" aria-labelledby="technologies-title">
        <h2 id="technologies-title">Technologies</h2>
        <ul class="tag-list tag-list--large">
          {project.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </section>
    )}

    {testCapabilities.length > 0 && (
      <section class="project-section container reading-width" aria-labelledby="testing-title">
        <h2 id="testing-title">Tests et validation observés</h2>
        <ul class="evidence-list">
          {testCapabilities.map((capability) => <li>{capability}</li>)}
        </ul>
        <p>Aucun total fixe ni état global d’exécution n’est affirmé sans rapport d’exécution courant.</p>
      </section>
    )}

    {executionEvidence.length > 0 && (
      <section class="project-section container" aria-labelledby="execution-evidence-title">
        <h2 id="execution-evidence-title">Exécution et code observés</h2>
        <p class="architecture-intro">Sorties réelles de tests et extraits de code, reproduits tels quels.</p>
        <EvidenceStack items={executionEvidence} />
      </section>
    )}

    {project.project_id === 'project-ecv' && (
      <section class="project-section container reading-width boundary-note" aria-labelledby="security-boundary-title">
        <h2 id="security-boundary-title">Portée de la preuve sécurité</h2>
        <p>Les mécanismes observés et la présence de tests ne constituent pas un audit cryptographique ou une certification de sécurité indépendante.</p>
      </section>
    )}

    {project.limitations.length > 0 && (
      <section class="project-section project-section--limitations" aria-labelledby="limitations-title">
        <div class="container reading-width">
          <h2 id="limitations-title">Limites connues</h2>
          <ul class="evidence-list">
            {project.limitations.map((limitation) => <li>{limitation}</li>)}
          </ul>
        </div>
      </section>
    )}

    <section class="project-section container" aria-labelledby="related-title">
      <SectionHeading id="related-title" title="Projets liés à explorer" />
      <ProjectGrid projects={relatedProjects} compact label="Deux projets liés" />
    </section>
  </article>
</BaseLayout>
