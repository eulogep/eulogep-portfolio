    sources: '/evidence/hub/isolation-account-a-640.avif 640w, /evidence/hub/isolation-account-a-960.avif 960w, /evidence/hub/isolation-account-a-980.avif 980w',
    width: 980,
    height: 500,
    alt: 'Page Organisations de Professional Hub où le compte A voit son organisation de démonstration.',
    label: 'Validation réelle',
  },
  {
    id: 'gallery-corrector',
    index: '03',
