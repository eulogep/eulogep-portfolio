---
import { carouselProject, type CarouselItem } from '../../lib/carousel-projects';
import '../../styles/glass-carousel.css';

interface Props {
  items: CarouselItem[];
  variant?: 'hero' | 'showcase';
  autoPlay?: boolean;
  interval?: number;
  /** Name of the bubbling CustomEvent carrying { projectId, index }. */
  onSelect?: string;
  initialIndex?: number;
  id: string;
  label: string;
}
const { items, variant = 'showcase', autoPlay = false, interval = 6500,
  onSelect = 'carousel:select', initialIndex = 0, id, label } = Astro.props;
const projects = items.map(carouselProject);
const technologies = [...new Set(items.flatMap((item) => item.technologies))].sort();
---

<glass-carousel id={id} class:list={['glass-carousel', `glass-carousel--${variant}`]}
  role="region" aria-label={label} data-initial-index={initialIndex}
  data-auto-play={String(autoPlay)} data-interval={Math.max(4000, interval)} data-select-event={onSelect}>
  {variant === 'showcase' && (
    <div class="glass-carousel__filters" hidden>
      <label for={`${id}-technology`}>Explorer par technologie</label>
      <select id={`${id}-technology`} data-filter>
        <option value="">Toutes les technologies</option>
        {technologies.map((technology) => <option value={technology}>{technology}</option>)}
      </select>
      <span class="glass-carousel__count">{projects.length} projets sélectionnés</span>
    </div>
  )}
  <div class="glass-carousel__stage" tabindex="-1" aria-label="Projets : flèches gauche et droite pour naviguer">
    {projects.map((project, index) => (
      <article class="glass-card" data-project-id={project.project_id} data-title={project.title}
        data-tone={project.tone} data-technologies={JSON.stringify(project.technologies)}
        aria-label={`${index + 1} sur ${projects.length} : ${project.title}`}>
        <div class="glass-card__topline"><span>{project.status} · {project.classification === 'FEATURED' ? 'Sélection' : 'Projet'}</span><span>{String(index + 1).padStart(2, '0')}</span></div>
        {project.image ? (
          <div class="glass-card__image">
            <img src={project.image.src} width={project.image.width} height={project.image.height}
              alt={`Aperçu de ${project.title}`} loading={variant === 'hero' && index === initialIndex ? 'eager' : 'lazy'} decoding="async" />
            <span>{project.image.label}</span>
          </div>
        ) : (
          <div class="glass-card__text-preview">
            <p class="eyebrow">{project.technologies.slice(0, 2).join(' / ')}</p>
            <p>{project.capabilities.slice(0, 2).join(' · ') || project.title}</p>
            <span>Présentation technique · capture à venir</span>
          </div>
        )}
        <div class="glass-card__body">
          <h3>{project.title}</h3>
          <p class="glass-card__description">{project.summary || project.capabilities.slice(0, 2).join(' · ')}</p>
          <ul class="tag-list" aria-label={`Technologies de ${project.title}`}>
            {project.technologies.slice(0, 3).map((technology) => <li>{technology}</li>)}
          </ul>
          <div class="glass-card__actions">
            {project.detailUrl && <a class="button" href={project.detailUrl}>Voir le projet</a>}
            {project.repository_url && <a class="text-link" href={project.repository_url} rel="noreferrer">GitHub</a>}
            {project.demoUrl && <a class="text-link" href={project.demoUrl} rel="noreferrer">Démo en ligne</a>}
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="glass-carousel__controls" hidden>
    <button type="button" data-prev aria-label="Projet précédent">Précédent</button>
    <div class="glass-carousel__position">
      <span class="glass-carousel__counter"></span>
      <p class="glass-carousel__active-title"></p>
    </div>
    <button type="button" data-next aria-label="Projet suivant">Suivant</button>
    {autoPlay && <button type="button" data-play aria-pressed="false">Lecture auto</button>}
  </div>
  <p class="glass-carousel__hint" hidden>Flèches du clavier ou glissement pour explorer</p>
  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-announcement></p>
</glass-carousel>

<script>
  import '../../scripts/glass-carousel';
</script>
