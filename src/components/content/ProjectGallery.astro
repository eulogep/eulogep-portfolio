---

<div class="gallery-shell">
  <nav class="gallery-index" aria-label="Accès direct aux images de la galerie">
    {items.map((item) => <a href={`#${item.id}`} aria-label={`Voir l’image ${item.index} : ${item.title}`}>{item.index}</a>)}
  </nav>
  <ol class="project-gallery" aria-label="Galerie de projets et de preuves">
    {items.map((item) => (
      <li id={item.id} class="gallery-card">
        <figure>
          <div class="gallery-card__media">
            <picture>
              <source type="image/avif" srcset={item.sources} sizes="(min-width: 72rem) 760px, 84vw" />
              <img src={item.image} width={item.width} height={item.height} alt={item.alt} loading="lazy" decoding="async" />
            </picture>
            <span>{item.label}</span>
          </div>
          <figcaption>
            <p class="eyebrow">{item.index} · {item.eyebrow}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a class="text-link" href={item.href}>{item.href.startsWith('/projects/') ? 'Explorer le cas d’étude' : 'Revenir au début du récit'}</a>
          </figcaption>
        </figure>
      </li>
    ))}
  </ol>
</div>
