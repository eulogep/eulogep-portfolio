---
import { levelLabels, type SkillGroup } from '../../lib/page-models';

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<div class="skill-groups">
  {
    groups.map((group) => (
      <section class="skill-group" aria-labelledby={`skill-group-${group.id}`}>
        <h3 id={`skill-group-${group.id}`}>{group.label}</h3>
        <ul class="skill-list">
          {group.skills.map((skill) => (
            <li>
              <span>{skill.label}</span>
              <span class="evidence-label">{levelLabels[skill.level_label]}</span>
              {skill.limitation && <small>{skill.limitation}</small>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
