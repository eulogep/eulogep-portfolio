/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; media-src 'self' https://manga-wave-bienvenue-fusion.vercel.app; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted build output: the filename changes whenever the bytes change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Evidence renditions are content-addressed by project/name/width and are
# replaced by a new build rather than edited in place.
/evidence/*
  Cache-Control: public, max-age=31536000, immutable

# Brand and icon files keep stable names, so they revalidate daily.
/brand/*
  Cache-Control: public, max-age=86400, must-revalidate

# Stable local posters revalidate daily; the video itself remains on Manga Wave.
/media/*
  Cache-Control: public, max-age=86400, must-revalidate

# The approved CV is versioned by review, not by filename: never serve a stale copy.
/cv/*.pdf
  Cache-Control: public, max-age=0, must-revalidate
