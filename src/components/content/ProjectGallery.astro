    href: '/projects/corrector-ai/',
    image: '/evidence/corrector/answer-key-entry-1180.webp',
    sources: '/evidence/corrector/answer-key-entry-640.avif 640w, /evidence/corrector/answer-key-entry-960.avif 960w, /evidence/corrector/answer-key-entry-1180.avif 1180w',
    width: 1180,
